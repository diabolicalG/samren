{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "es2022"],
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules"]
}
