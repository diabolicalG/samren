generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  username      String            @unique
  passwordHash  String
  role          UserRole          @default(USER)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  refreshTokens RefreshToken[]
  preferences   UserPreferences?
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserPreferences {
  id           String  @id @default(cuid())
  userId       String  @unique
  theme        String  @default("obsidian")
  autoPlayNext Boolean @default(true)
  subtitleLang String  @default("en")
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Anime {
  id                 String            @id @default(cuid())
  slug               String            @unique @db.VarChar(180)
  title              String            @db.VarChar(240)
  englishTitle       String?           @db.VarChar(240)
  nativeTitle        String?           @db.VarChar(240)
  alternateTitles    String[]          @default([])
  synopsis           String?
  type               AnimeType        @default(TV)
  releaseStatus      ReleaseStatus    @default(FINISHED)
  publicationStatus  PublicationStatus @default(DRAFT)
  releaseYear        Int?
  releaseSeason      SeasonName?
  seasonGroupId      String?
  ageRating          AgeRating?
  score              Int?
  featured           Boolean           @default(false)
  posterAssetId      String?
  bannerAssetId      String?
  publishedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  seasonGroup        Season?           @relation(fields: [seasonGroupId], references: [id], onDelete: SetNull)
  posterAsset        MediaAsset?       @relation("AnimePoster", fields: [posterAssetId], references: [id], onDelete: SetNull)
  bannerAsset        MediaAsset?       @relation("AnimeBanner", fields: [bannerAssetId], references: [id], onDelete: SetNull)
  genres             AnimeGenre[]
  studios             AnimeStudio[]
  episodes            Episode[]

  @@index([publicationStatus, featured, updatedAt])
  @@index([publicationStatus, releaseYear, releaseSeason])
  @@index([publicationStatus, type, releaseStatus])
  @@index([seasonGroupId])
}

model Genre {
  id        String       @id @default(cuid())
  slug      String       @unique @db.VarChar(100)
  name      String       @unique @db.VarChar(100)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  anime     AnimeGenre[]
}

model Studio {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(140)
  name        String        @unique @db.VarChar(160)
  description String?
  website     String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  anime       AnimeStudio[]
}

model AnimeGenre {
  animeId String
  genreId String
  anime   Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
  @@index([genreId, animeId])
}

model AnimeStudio {
  animeId  String
  studioId String
  anime    Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([animeId, studioId])
  @@index([studioId, animeId])
}

model Season {
  id        String      @id @default(cuid())
  year      Int
  season    SeasonName
  label     String?     @db.VarChar(100)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  anime     Anime[]

  @@unique([year, season])
  @@index([year, season])
}

model Episode {
  id                 String            @id @default(cuid())
  animeId            String
  seasonId           String?
  episodeNumber      Int
  absoluteNumber     Int?
  title              String            @db.VarChar(240)
  synopsis           String?
  durationSeconds    Int?
  airDate            DateTime?
  publicationStatus  PublicationStatus @default(DRAFT)
  isFiller           Boolean           @default(false)
  isRecap            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  anime              Anime             @relation(fields: [animeId], references: [id], onDelete: Cascade)
  season             Season?           @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  media              EpisodeMedia[]
  subtitles          SubtitleTrack[]

  @@unique([animeId, episodeNumber])
  @@index([animeId, publicationStatus, episodeNumber])
  @@index([seasonId, episodeNumber])
}

model MediaAsset {
  id                String               @id @default(cuid())
  storageKey        String               @unique @db.VarChar(500)
  originalFilename  String               @db.VarChar(255)
  mediaKind         MediaKind
  mimeType          String               @db.VarChar(120)
  sizeBytes         BigInt
  checksumSha256    String?              @unique @db.VarChar(64)
  processingState   AssetProcessingState @default(PENDING)
  width             Int?
  height            Int?
  durationSeconds   Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  posterFor         Anime[]              @relation("AnimePoster")
  bannerFor         Anime[]              @relation("AnimeBanner")
  episodeMedia      EpisodeMedia[]
  subtitleTracks    SubtitleTrack[]

  @@index([mediaKind, processingState, createdAt])
}

model EpisodeMedia {
  id           String     @id @default(cuid())
  episodeId    String
  assetId      String
  qualityLabel String?    @db.VarChar(40)
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  episode      Episode    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([episodeId, assetId])
  @@index([episodeId, isDefault])
}

model SubtitleTrack {
  id           String     @id @default(cuid())
  episodeId    String
  assetId      String
  languageCode String     @db.VarChar(16)
  label        String     @db.VarChar(80)
  format       SubtitleFormat
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  episode      Episode    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([episodeId, assetId])
  @@index([episodeId, languageCode])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnimeType {
  TV
  MOVIE
  OVA
  ONA
  SPECIAL
}

enum ReleaseStatus {
  AIRING
  FINISHED
  NOT_YET_AIRED
  CANCELLED
}

enum SeasonName {
  WINTER
  SPRING
  SUMMER
  FALL
}

enum AgeRating {
  G
  PG
  PG_13
  R
  R_PLUS
  RX
}

enum MediaKind {
  POSTER
  BANNER
  VIDEO
  SUBTITLE
}

enum AssetProcessingState {
  PENDING
  READY
  FAILED
}

enum SubtitleFormat {
  SRT
  VTT
  ASS
}
