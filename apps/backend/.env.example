NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://samren:change-me@localhost:5432/samren?schema=public
MEDIA_STORAGE_ROOT=.data/media
ANIVEXA_ENABLED=false
# Add only verified provider API/site hosts required by the providers you enable.
# The adapters may need graphql.anilist.co, animegg.org, anizone.to, anikototv.to,
# kaa.lt, aniwaves.ru, reanime.to, animenosub.to, ani.pm, embed.settlar.io,
# senshi.to, s.vidcloud.se, and anime-dunya.com. AnimeOnsen has separate API/search
# allowlists below. Do not add wildcard domains.
ANIVEXA_ALLOWED_HOSTS=
# Add only verified CDN/media hosts returned by providers. Include each actual media host.
ANIVEXA_STREAM_ALLOWED_HOSTS=
ANIVEXA_ANIMEONSEN_API_HOSTS=
ANIVEXA_ANIMEONSEN_SEARCH_HOSTS=
# Provider worker controls: concurrent extraction tasks, bounded waiting queue,
# failures before circuit-open, and circuit cooldown duration.
ANIVEXA_WORKER_CONCURRENCY=11
ANIVEXA_WORKER_QUEUE_MAX=64
ANIVEXA_PROVIDER_FAILURE_THRESHOLD=3
ANIVEXA_PROVIDER_COOLDOWN_MS=30000
