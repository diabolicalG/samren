NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://samren:change-me@localhost:5432/samren?schema=public
# Development default is relative to the backend working directory.
# Production must set an absolute persistent path outside public web roots.
MEDIA_STORAGE_ROOT=.data/media
MEDIA_UPLOAD_IMAGE_MAX_BYTES=15728640
MEDIA_UPLOAD_VIDEO_MAX_BYTES=2147483648
MEDIA_UPLOAD_SUBTITLE_MAX_BYTES=2097152
MEDIA_UPLOAD_TIMEOUT_MS=900000
ANIVEXA_ENABLED=false
# Add only verified provider API/site hosts required by the providers you enable.
# Do not add wildcard domains.
ANIVEXA_ALLOWED_HOSTS=
# Add only verified CDN/media hosts returned by providers.
ANIVEXA_STREAM_ALLOWED_HOSTS=
ANIVEXA_ANIMEONSEN_API_HOSTS=
ANIVEXA_ANIMEONSEN_SEARCH_HOSTS=
ANIVEXA_WORKER_CONCURRENCY=11
ANIVEXA_WORKER_QUEUE_MAX=64
ANIVEXA_PROVIDER_FAILURE_THRESHOLD=3
ANIVEXA_PROVIDER_COOLDOWN_MS=30000

# Use a unique random secret of at least 32 characters in production.
PLAYBACK_SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
