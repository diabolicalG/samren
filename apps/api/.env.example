# Native Kuhi provider integration
KUHI_ENABLED=true
# Comma-separated HTTPS hostnames approved for direct stream/subtitle URLs.
# Leave empty until you have reviewed and approved the provider/CDN host list.
KUHI_STREAM_ALLOWED_HOSTS=
# Comma-separated HTTPS hosts the provider scrapers may contact (include AniList and provider/CDN hosts).
# Empty means outbound Kuhi requests are blocked.
KUHI_PROVIDER_ALLOWED_HOSTS=
