# --- apps/api (gateway) ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://samren:samren@localhost:5432/samren
JWT_SECRET=change-me-in-production
REDIS_URL=redis://localhost:6379
SHIVRA_API_URL=http://localhost:8000
# Comma-separated list of origins allowed to call the gateway from a browser.
# Must include every frontend app's own origin (web AND admin).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Set to "true" to skip creating the default admin user on startup
# (recommended once you have real accounts / in any shared environment).
SKIP_SEED_ADMIN=false

# --- apps/web / apps/admin -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- services/shivra-api ---------------------------------------------------
# No required env vars today; runs on port 8000 by default.
