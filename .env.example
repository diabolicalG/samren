# Samren environment template
# Copy to .env for local Docker development and replace all placeholder secrets.

# --- Core database ---------------------------------------------------------
# Keep POSTGRES_PASSWORD URL-safe when it is embedded in DATABASE_URL.
POSTGRES_USER=samren
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_DB=samren
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API gateway -----------------------------------------------------------
APP_ENV=development
API_PORT=4000
API_WORKERS=2
API_LIMIT_CONCURRENCY=100
API_PROXY_CONCURRENCY=32
API_STREAM_CONCURRENCY=8
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SHIVRA_PORT=8000
SHIVRA_WORKERS=2
SHIVRA_LIMIT_CONCURRENCY=100
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_POLL_INTERVAL=2
DOWNLOAD_STALE_AFTER=21600
DOWNLOAD_MAX_BYTES=5368709120
DATABASE_URL=postgresql://samren:replace-with-a-strong-password@localhost:5432/samren?schema=public
DIRECT_URL=postgresql://samren:replace-with-a-strong-password@localhost:5432/samren?schema=public
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379
RATE_LIMIT_STORAGE_URI=redis://localhost:6379
SHIVRA_API_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SEED_ADMIN=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Unified media metadata providers -------------------------------------
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
ANILIST_URL=https://graphql.anilist.co
TVMAZE_BASE_URL=https://api.tvmaze.com
MEDIA_API_HTTP_TIMEOUT=10
MEDIA_API_HTTP_RETRIES=2
MEDIA_API_HTTP_RETRY_BASE_DELAY=0.5
MEDIA_API_HTTP_RETRY_MAX_DELAY=5
MEDIA_API_CACHE_TTL_SEARCH=300
MEDIA_API_CACHE_TTL_DETAIL=86400
MEDIA_API_CACHE_TTL_TRENDING=900
MEDIA_API_CACHE_TTL_SCHEDULE=300

# --- Frontends -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
ADMIN_PORT=3001
HTTP_PORT=80
