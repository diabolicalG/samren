# samren-web
FROM node:20-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

# Dependencies layer
FROM base AS deps
COPY package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/
COPY packages/*/package.json packages/*/
RUN pnpm install --frozen-lockfile --filter "web" --filter "@samren/types" --filter "@samren/ui" --filter "@samren/hooks" --filter "@samren/api-client" --filter "@samren/utils"

# Build layer
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./apps/web
COPY packages ./packages
COPY tsconfig.json ./

WORKDIR /app/apps/web
RUN pnpm build

# Runtime layer
FROM node:20-alpine AS runner
WORKDIR /app/apps/web

ENV PNPM_HOME="/pnpm"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

COPY --from=builder /app/apps/web/.next ./.next
COPY --from=builder /app/apps/web/public ./public
COPY --from=builder /app/apps/web/package.json ./package.json
COPY --from=builder /app/apps/web/next.config.mjs ./next.config.mjs
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000
# NOTE: this runs `next start` against the full .next build output (not
# Next's `standalone` output), since `standalone` requires careful output
# file tracing across a pnpm monorepo that isn't configured here. This is
# a heavier image than `standalone` would produce, but it's what actually
# runs correctly — verified directly against this Dockerfile's own build.
CMD ["pnpm", "start"]
