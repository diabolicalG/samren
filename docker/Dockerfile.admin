# samren-admin
FROM node:20-alpine AS base

ENV PNPM_HOME="/pnpm"

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

# Dependencies layer
FROM base AS deps
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/
COPY packages/*/package.json packages/*/
RUN pnpm install --frozen-lockfile

# Build layer
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/admin/node_modules ./apps/admin/node_modules
COPY apps/admin ./apps/admin
COPY packages ./packages
COPY tsconfig.json ./
COPY apps/tsconfig.json ./apps/tsconfig.json

WORKDIR /app/apps/admin
RUN pnpm build

# Runtime layer
FROM node:20-alpine AS runner
WORKDIR /app/apps/admin

ENV PNPM_HOME="/pnpm"
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

COPY --from=builder /app/apps/admin/.next ./.next
COPY --from=builder /app/apps/admin/public ./public
COPY --from=builder /app/apps/admin/package.json ./package.json
COPY --from=builder /app/apps/admin/next.config.mjs ./next.config.mjs
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3001
# See Dockerfile.web for why this uses `next start` rather than
# `node server.js` / Next's `standalone` output.
CMD ["pnpm", "start", "--", "-p", "3001"]
