{
  "name": "samren",
  "version": "0.1.0",
  "private": true,
  "description": "Samren — application-owned anime catalogue and personal library",
  "scripts": {
    "dev": "pnpm --parallel --filter @samren/frontend --filter @samren/backend dev",
    "dev:frontend": "pnpm --filter @samren/frontend dev",
    "dev:backend": "pnpm --filter @samren/backend dev",
    "build": "pnpm --filter @samren/types build --if-present && pnpm --filter @samren/frontend build && pnpm --filter @samren/backend build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "pnpm --filter @samren/frontend typecheck && pnpm --filter @samren/backend typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/api-client",
    "packages/types",
    "packages/prettier-config",
    "packages/typescript-config"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@samren/typescript-config": "workspace:*",
    "@samren/prettier-config": "workspace:*",
    "husky": "^9.1.0",
    "prettier": "^3.4.0",
    "turbo": "^2.1.0",
    "typescript": "^5.7.0"
  }
}
